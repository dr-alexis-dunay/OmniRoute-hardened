# OmniRoute (rama hardening-audit) — configuración recomendada. Genera TUS valores; no reutilices ejemplos.
OMNIROUTE_SERVER_HOST=127.0.0.1          # solo loopback (ahora es el valor por defecto en esta rama)
REQUIRE_API_KEY=true                     # /v1 sin clave -> 401 (ahora por defecto)
INITIAL_PASSWORD=<contraseña-larga-unica> # se genera aleatoria si .env se crea desde .env.example
STORAGE_ENCRYPTION_KEY=<openssl rand -base64 32>
OMNIROUTE_REQUIRE_ENCRYPTION=true        # rechaza guardar credenciales en texto plano
JWT_SECRET=<openssl rand -base64 48>
API_KEY_SECRET=<openssl rand -hex 32>
# Privacidad: NO definir OMNIROUTE_CALL_LOG_BODIES (por defecto los cuerpos no se guardan).
# OMNIROUTE_CALL_LOG_BODIES=true         # solo en entornos SIN datos clínicos
# Rendimiento: el retardo fijo de 350 ms ya no existe; para restaurarlo:
# OMNIROUTE_MIN_TIME_BETWEEN_REQUESTS_MS=350
